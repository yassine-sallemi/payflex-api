            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "payflex_pipeline_last_gate_status",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 2,
                "color": "red"
              }
            ]
          },
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PASS",
                  "color": "green",
